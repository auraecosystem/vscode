# /etc/nginx/sites-available/vscode.dev (or /var/www/vscode.dev/nginx.conf)

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name vscode.yourdomain.com; # Replace with your domain name or server IP

    # Increase maximum upload file size for dragging files into the VS Code explorer
    client_max_body_size 500M;

    # Logging paths
    access_log /var/log/nginx/vscode_access.log;
    error_log  /var/log/nginx/vscode_error.log;

    location / {
        # Points to local code-server instance (or use 'http://vscode-web:8080' if inside Docker)
        proxy_pass http://127.0.0.1:8080;

        # Standard Proxy Headers
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # WebSocket Proxying (Required for VS Code terminal, IPC, and extensions)
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Disable buffering for real-time output streaming
        proxy_buffering off;

        # Extended timeouts to prevent terminal & long tasks from dropping connections
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }
}
